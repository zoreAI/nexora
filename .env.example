# ============================================
# ChatGPT2API 环境变量配置示例
# ============================================

# 认证密钥（必填）
CHATGPT2API_AUTH_KEY=your_secret_key_here

# 基础 URL（可选，用于生成图片 URL）
# CHATGPT2API_BASE_URL=https://your-domain.com

# 图片任务后台队列（默认 16 个 worker、256 个排队名额）
# CHATGPT2API_IMAGE_TASK_WORKERS=16
# CHATGPT2API_IMAGE_TASK_QUEUE_SIZE=256

# 提示词库远端仓库地址（可选，默认使用 yukkcat/image-prompts 的 dist 目录）
# PROMPT_LIBRARY_REGISTRY_URL=https://raw.githubusercontent.com/yukkcat/image-prompts/main/dist

# ============================================
# 存储后端配置
# ============================================

# 数据库由 DATABASE_URL 自动选择；不设置时使用 SQLite

# ============================================
# 数据库配置；不设置时 SQLite 默认使用 data/chatgpt2api.db
# ============================================

# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api
# 本机 PostgreSQL 使用 Unix socket（数据库和角色均为当前用户可访问时）
# DATABASE_URL=postgresql:///nexora?host=/tmp

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 自定义绝对路径示例
# DATABASE_URL=sqlite:///app/data/chatgpt2api.db
